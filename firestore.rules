rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        isSignedIn() && (
          (request.auth.token.email == 'amiruddin@smpialwasi-maros.sch.id') ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Connection test rule (Mandatory per Firebase Skill)
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Validation helper for Users
    function isValidUser(data) {
      return data.nama is string && data.nama.size() <= 100 &&
             data.gudep in ['10-035', '10-036'] &&
             data.satuan in ['Putra', 'Putri'] &&
             data.sangga in ['Perintis', 'Penegas', 'Pendobrak', 'Pencoba', 'Pelaksana'] &&
             data.role in ['admin', 'anggota'];
    }

    // Users collection (Members & Admin can create/view scout profiles)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // Validation helper for Attendance Sessions
    function isValidSession(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.isOpen is bool &&
             data.tipe in ['Latihan Rutin', 'Kegiatan'];
    }

    // Attendance Sessions collection (Admin opens/closes roll call, all members view active status)
    match /attendance_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId) && isValidSession(incoming());
      allow delete: if isAdmin();
    }

    // Validation helper for Attendance Records
    function isValidAttendanceRecord(data) {
      return data.sessionId is string && data.sessionId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.gudep in ['10-035', '10-036'] &&
             data.sangga in ['Perintis', 'Penegas', 'Pendobrak', 'Pencoba', 'Pelaksana'] &&
             data.status in ['Hadir', 'Izin', 'Sakit', 'Alpa'];
    }

    // Attendance Records collection (Members fill roll call, admin views/edits records)
    match /attendance_records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidAttendanceRecord(incoming());
      allow delete: if isAdmin();
    }

    // Validation helper for Program Kerja
    function isValidProgramKerja(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.tipe in ['Kegiatan', 'Latihan Rutin'] &&
             data.nama is string && data.nama.size() <= 150 &&
             data.bulan is string && data.bulan.size() <= 30 &&
             data.status in ['Direncanakan', 'Berjalan', 'Terlaksana', 'Tidak Terlaksana'];
    }

    // Program Kerja collection (Visible to all viewers/members, managed by admin)
    match /program_kerja/{prokerId} {
      allow read: if true;
      allow create, update: if isValidId(prokerId) && isValidProgramKerja(incoming());
      allow delete: if isValidId(prokerId);
    }

    // Validation helper for Materi Belajar
    function isValidMateri(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.judul is string && data.judul.size() <= 200 &&
             data.kategori is string && data.kategori.size() <= 100 &&
             data.tipeFormat in ['original', 'ai_generated'];
    }

    // Validation helper for Ambalan Chat
    function isValidChat(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.type in ['text', 'list'];
    }

    // Ambalan Chat collection (Realtime group chat & interactive lists)
    match /ambalan_chats/{chatId} {
      allow read: if true;
      allow create, update: if isValidId(chatId) && isValidChat(incoming());
      allow delete: if isValidId(chatId);
    }
  }
}
